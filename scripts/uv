#!/usr/bin/env python3
"""Select the exact project-local uv without installing or changing global tools."""

from __future__ import annotations

import os
import re
import subprocess
import sys
import tomllib
from pathlib import Path


def main() -> int:
    root = Path(__file__).resolve().parents[1]
    try:
        configuration = tomllib.loads((root / "pyproject.toml").read_text())
        pin = configuration["tool"]["uv"]["required-version"]
        match = re.fullmatch(r"==(\d+\.\d+\.\d+)", pin) if isinstance(pin, str) else None
        if match is None:
            raise ValueError("pyproject.toml must declare an exact uv version")
        version = match.group(1)
        binary = root / ".tools" / "uv" / version / "bin" / "uv"
        probe = subprocess.run(  # noqa: S603 - fixed local tool, exact declared pin, no shell
            [str(binary), "--version"], capture_output=True, text=True, timeout=5, check=False
        )
        if probe.returncode != 0 or probe.stdout.split()[:2] != ["uv", version]:
            raise ValueError(f"expected uv {version} at {binary}")
        environment = os.environ.copy()
        environment["PATH"] = str(binary.parent) + os.pathsep + environment.get("PATH", "")
        os.chdir(root)
        os.execve(binary, [str(binary), *sys.argv[1:]], environment)  # noqa: S606 - explicit local-tool delegation
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
        print(
            f"project-local uv unavailable: {error}\n"
            "See docs/REPRODUCIBILITY.md; no global fallback or automatic installation occurred.",
            file=sys.stderr,
        )
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
